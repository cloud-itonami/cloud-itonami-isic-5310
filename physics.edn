;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": in postal activities (ISIC 5310) a robot may do
;; mail sorting, palletising and conveyor handling in the sorting facility,
;; gated by facility policy. Physical work modelled here: an arm palletising
;; mail sacks / trays off the sorter's output chute, and a tugger pulling a
;; train of roll cages from the sorting floor up the dock ramp to the
;; loading bay.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-5310"
 :cases
 [{:id :mail-sack-palletise
   :kind :manipulator
   :procedure "palletising arm lifts a mail sack from the sorter output chute and places it on the top layer of the dispatch pallet"
   :params {:l1-m 0.85 :l2-m 0.75 :m1-kg 15.0 :m2-kg 10.0
            :from [1.00 0.20] :to [0.50 1.20] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [5.0 10.0 15.0 20.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 450.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload palletising arm class"}
   :boundary {:lo 1.0 :hi 100.0}}
  {:id :roll-cage-train-to-dock
   :kind :transport
   :procedure "tugger pulls three loaded roll cages (1200 kg) 100 m from the sorting floor up the dock ramp to the loading bay"
   :params {:mass-kg 450.0 :payload-kg 1200.0 :distance-m 100.0 :v-max-mps 1.5 :a-max-mps2 0.4
            :brake-decel-mps2 1.0 :drive-force-n 1800.0 :crr 0.015
            :cog-height-m 0.4 :support-half-length-m 0.5 :max-time-s 1800.0}
   :sweep {:param :slope-deg :values [0.0 2.0 4.0 5.0 6.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: one floor-to-dock leg inside the dispatch-wave window before the truck departure cut-off"}
   :boundary {:lo 0.0 :hi 8.0}}]}
